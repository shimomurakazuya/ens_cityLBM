# Nvidia P100 on Tsubame3.0 (Tokyo Tech, Japan)
COMPILER  = nvcc
CXXFLAGS  = -arch=sm_60 -x cu -O3 -std=c++14 -restrict --expt-extended-lambda -use_fast_math --default-stream per-thread
CXXFLAGS += -maxrregcount 127 --nvlink-options -Werror
CXXFLAGS += -ccbin mpicxx
LDFLAGS = -lm -lstdc++ -lz
TARGET = $(OUT_DIR)/citylbm.p100_cuda

# Linker
LINKER = nvcc -ccbin mpicxx

